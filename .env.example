# انسخ هذا الملف إلى .env وعدّل القيم
PORT=3000
# سر توقيع الجلسات - ولّد قيمة عشوائية طويلة (أو اتركه ليتولد تلقائياً في data/.jwt-secret)
JWT_SECRET=
# حساب المالك الأول (يُنشأ فقط إذا لم يوجد مستخدمون)
ADMIN_USER=admin
ADMIN_PASSWORD=غيرني-فوراً
# مجلد البيانات (اختياري)
